{
  "private": true,
  "name": "x402-sdk-interop",
  "type": "module",
  "packageManager": "pnpm@10.14.0",
  "scripts": {
    "capabilities": "tsx src/print-capabilities.ts",
    "capabilities:json": "tsx src/print-capabilities.ts --json",
    "scaffold": "tsx src/print-scaffold.ts",
    "scaffold:json": "tsx src/print-scaffold.ts --json",
    "test": "vitest run",
    "test:boundaries": "vitest run test/boundary.test.ts test/exact-fixtures.test.ts",
    "test:ci": "pnpm typecheck && X402_INTEROP_PROFILE=reference-spine X402_INTEROP_REFERENCE=rust pnpm test:smoke && X402_INTEROP_PROFILE=reference-spine X402_INTEROP_REFERENCE=rust pnpm test:boundaries",
    "test:experimental": "vitest run test/capabilities.test.ts test/contracts.test.ts test/report-cli.test.ts test/scaffold.test.ts test/upto-fixtures.test.ts test/batch-settlement-fixtures.test.ts test/session-fixtures.test.ts test/subscription-fixtures.test.ts test/planned-adapters.test.ts",
    "test:language:rust": "X402_INTEROP_CLIENTS=rust X402_INTEROP_SERVERS=rust vitest run test/e2e.test.ts",
    "test:language:typescript": "X402_INTEROP_CLIENTS=typescript X402_INTEROP_SERVERS=typescript vitest run test/e2e.test.ts",
    "test:pair:rust-ts": "X402_INTEROP_CLIENTS=rust X402_INTEROP_SERVERS=typescript vitest run test/e2e.test.ts",
    "test:pair:ts-rust": "X402_INTEROP_CLIENTS=typescript X402_INTEROP_SERVERS=rust vitest run test/e2e.test.ts",
    "test:planned-adapters": "vitest run test/planned-adapters.test.ts",
    "test:probe:planned-syntax": "pnpm test:probe:python-syntax && pnpm test:probe:go-build && pnpm test:probe:ruby-syntax && pnpm test:probe:php-syntax",
    "test:probe:python-syntax": "cd ../../python && python3 -m compileall -q src",
    "test:probe:python-client": "X402_INTEROP_CLIENTS=python X402_INTEROP_SERVERS=rust pnpm test:smoke",
    "test:probe:python-server": "X402_INTEROP_CLIENTS=typescript X402_INTEROP_SERVERS=python pnpm test:smoke",
    "test:probe:go-build": "cd ../../go && go test ./...",
    "test:probe:go-client": "X402_INTEROP_CLIENTS=go X402_INTEROP_SERVERS=rust pnpm test:smoke",
    "test:probe:go-server": "X402_INTEROP_CLIENTS=typescript X402_INTEROP_SERVERS=go pnpm test:smoke",
    "test:probe:ruby-syntax": "cd ../../ruby && ruby -c bin/interop-client && ruby -c bin/interop-server",
    "test:probe:ruby-client": "X402_INTEROP_CLIENTS=ruby X402_INTEROP_SERVERS=rust pnpm test:smoke",
    "test:probe:ruby-server": "X402_INTEROP_CLIENTS=typescript X402_INTEROP_SERVERS=ruby pnpm test:smoke",
    "test:probe:php-syntax": "php -l ../../php/bin/interop-server.php",
    "test:probe:php-server": "X402_INTEROP_CLIENTS=typescript X402_INTEROP_SERVERS=php pnpm test:smoke",
    "test:probe:lua-syntax": "cd ../../lua && if command -v luac >/dev/null 2>&1; then luac -p bin/interop-server.lua; elif command -v lua >/dev/null 2>&1; then lua -e 'assert(loadfile(\"bin/interop-server.lua\"))'; else echo 'Lua toolchain not found; install lua or luac to run this probe' >&2; exit 127; fi",
    "test:probe:lua-server": "X402_INTEROP_CLIENTS=typescript X402_INTEROP_SERVERS=lua pnpm test:smoke",
    "test:smoke": "vitest run test/e2e.test.ts --testNamePattern \"client pays\"",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@solana/kit": "^5.1.0",
    "@solana/x402": "file:../../typescript/packages/x402",
    "@x402/core": "^2.9.0",
    "surfpool-sdk": "^1.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
