#!/usr/bin/env ruby
# frozen_string_literal: true

require "json"
require "net/http"
require "uri"

$LOAD_PATH.unshift(File.expand_path("../lib", __dir__))
require "x402_sdk/interop/client"

target_url = ENV.fetch("X402_INTEROP_TARGET_URL")
response = Net::HTTP.get_response(URI(target_url))

headers = {}
response.each_header do |key, value|
  headers[key] = value
end
selected_requirement = X402SDK::Interop::Client.select_svm_requirement(
  headers: headers,
  body: response.body,
  network: ENV.fetch("X402_INTEROP_NETWORK", "solana:EtWTRABZaYq6iMfeYKouRu166VU2xqa1"),
  scheme: ENV.fetch("X402_INTEROP_SCHEME", "exact")
)
scheme = ENV.fetch("X402_INTEROP_SCHEME", "exact")

puts JSON.generate(
  type: "result",
  implementation: "ruby",
  role: "client",
  ok: false,
  status: response.code.to_i,
  responseHeaders: headers,
  responseBody: {
    error: "ruby_#{scheme}_client_not_implemented",
    challengeStatus: response.code.to_i,
    challengeBody: response.body,
    selectedRequirement: selected_requirement
  },
  settlement: nil
)
